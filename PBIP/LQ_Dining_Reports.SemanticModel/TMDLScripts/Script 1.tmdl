createOrReplace

	ref table _Measures
		/// Net sales compared with the same period last year, as a %
		measure 'Net Sales YoY %' = DIVIDE([Net Sales YoY], [Net Sales LY])
			formatString: 0.0%;-0.0%;0.0%
			isHidden
			displayFolder: Time Intelligence
			lineageTag: aa55f41d-87eb-4f33-affa-687cc9cb7d74

			changedProperty = IsHidden

