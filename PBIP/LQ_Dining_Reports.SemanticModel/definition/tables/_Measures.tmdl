	measure 'Commission Cost' =
			
			SUMX (
			    fact_sales_lines,
			    fact_sales_lines[net_amount] * RELATED ( dim_channel[commission_rate] )
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: Sales
		lineageTag: 26aa4b0d-d3e5-4851-94c4-28940329b36d

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Net Sales After Commission' = [Net Sales] - [Commission Cost]
