		displayFolder: Menu Engineering
		lineageTag: 24660bfc-eae0-4a3e-995e-b7049154d5e8

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Menu Mix %' = ```
			
			    VAR TotalItemsSold = CALCULATE([Items Sold], ALLSELECTED(dim_menu_item))
			    RETURN DIVIDE([Items Sold], TotalItemsSold)
			```
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Menu Engineering
		lineageTag: 9f106a25-305b-46cd-bbe9-28adfc98023e

	measure 'Popularity Threshold' = ```
			
			    DIVIDE (
			        0.7,
			        CALCULATE ( DISTINCTCOUNT ( fact_sales_lines[menu_item_id] ), ALLSELECTED ( dim_menu_item ) )
			    )
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Menu Engineering
		lineageTag: 1b63203c-224d-4dd5-9f41-48c242de5373

	measure 'Avg Profit per Plate' = CALCULATE([Profit per Plate], ALLSELECTED(dim_menu_item))
		formatString: 0.0
		displayFolder: Menu Engineering
		lineageTag: 35275e09-4c5d-40c2-8a9b-dae05c3b9002

	measure 'Menu Class' =
			
			IF (
			    HASONEVALUE ( dim_menu_item[menu_item_name] ),
			    VAR MixPct       = [Menu Mix %]
			    VAR Threshold    = [Popularity Threshold]
			    VAR Profit       = [Profit per Plate]
			    VAR AvgProfit    = [Avg Profit per Plate]
			    VAR IsPopular    = MixPct >= Threshold
			    VAR IsProfitable = Profit >= AvgProfit
			    RETURN
			        SWITCH (
			            TRUE (),
			            IsPopular && IsProfitable, "Star",
			            IsPopular,                 "Plowhorse",
			            IsProfitable,              "Puzzle",
			            "Dog"
			        )
			)
		displayFolder: Menu Engineering
		lineageTag: 12d92aaf-393a-44d4-a1f4-a999366c01e1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Menu Class Colour' =
			
			SWITCH (
			    [Menu Class],
			    "Star", "#2E6B5E",
			    "Plowhorse", "#C8962E",
			    "Puzzle", "#6C8FA6",
			    "Dog", "#B23A2E"
			)
		displayFolder: Menu Engineering
		lineageTag: 21eaf52c-f527-48b0-85b8-2330a723a884

	measure 'Branch Detail Title' = ```
			
			    VAR Title = SELECTEDVALUE(dim_branch[branch_name], "All Branches")
			    VAR Subtitle = "Performance Year - " & SELECTEDVALUE ( dim_date[year], "All years" )
			    RETURN Title & UNICHAR(10) & Subtitle
			```
		displayFolder: Branch Group Benchmarks
		lineageTag: 37c72bc1-b55f-4e3d-9a71-5496175675bb

	measure 'Group Prime Cost %' = CALCULATE ( [Prime Cost %], REMOVEFILTERS ( dim_branch ))
