	measure 'Available Seat Hours' =
			
			SUMX (
			    dim_branch,
			    VAR OpenDate = dim_branch[opening_date]
			    VAR TradingDays =
			        CALCULATE (
			            COUNTROWS ( dim_date ),
			            KEEPFILTERS ( dim_date[is_trading_day] = TRUE () ),
			            KEEPFILTERS ( dim_date[has_sales_data] = TRUE () ),
			            KEEPFILTERS ( dim_date[date] >= OpenDate )
			        )
			    RETURN
			        dim_branch[seats] * dim_branch[trading_hours_per_day] * TradingDays
			)
		formatString: #,0
		displayFolder: Sales
		lineageTag: 0aab38f4-e89d-4ebf-a32e-16f72b485628

	measure RevPASH = DIVIDE ( [Dine-in Sales], [Available Seat Hours] )
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
