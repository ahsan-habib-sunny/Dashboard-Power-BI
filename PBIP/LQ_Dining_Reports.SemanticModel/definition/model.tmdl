model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["bridge_recipe","dim_branch","dim_campaign","dim_channel","dim_customer","dim_date","dim_ingredient","dim_menu_item","dim_role","dim_supplier","dim_time","fact_bookings","fact_budget","fact_labour_shifts","fact_marketing_spend","fact_orders","fact_purchases","fact_reviews","fact_sales_lines","fact_wastage","_Measures","DataFolder","RangeStart","RangeEnd"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode","TMDLView_Desktop"]

ref table bridge_recipe
ref table dim_branch
ref table dim_campaign
ref table dim_channel
ref table dim_customer
ref table dim_date
ref table dim_ingredient
ref table dim_menu_item
ref table dim_role
ref table dim_supplier
ref table dim_time
ref table fact_bookings
ref table fact_budget
ref table fact_labour_shifts
ref table fact_marketing_spend
ref table fact_orders
ref table fact_purchases
ref table fact_reviews
ref table fact_sales_lines
ref table fact_wastage
ref table _Measures

ref role 'NQ Branch Manager'
ref role 'Head Office'

ref cultureInfo en-US

